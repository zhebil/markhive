{
  "manifest_version": 3,
  "name": "Markhive",
  "version": "1.0.0",
  "description": "Export the open Claude.ai conversation to a Markdown file. Local only, no servers, no telemetry.",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "action": { "default_popup": "popup/popup.html", "default_title": "Markhive" },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
