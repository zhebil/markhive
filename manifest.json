{
  "manifest_version": 3,
  "name": "Markhive",
  "version": "0.2.0",
  "description": "Export Claude conversations to Markdown.",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "action": { "default_popup": "popup/popup.html", "default_title": "Markhive" },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
